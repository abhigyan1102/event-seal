{
  "name": "eventseal",
  "version": "0.0.0",
  "private": true,
  "description": "Verification infrastructure for Solana events consumed by off-chain systems.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run build:functions",
    "build:functions": "node scripts/build-functions.mjs",
    "fixtures:devnet": "node scripts/generate-devnet-fixtures.mjs",
    "prepare": "husky",
    "dev": "npm run build --workspace @eventseal/sdk && npm run dev --workspace @eventseal/web",
    "test": "npm run test --workspaces --if-present && npm run test:functions && npm run test:scripts",
    "test:functions": "vitest run functions/_shared/*.test.ts",
    "test:scripts": "vitest run scripts/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke:devnet-backend": "node scripts/smoke-devnet-backend-proof.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.18"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@solana/kit": "8.0.0",
    "@solana/kit-plugin-rpc": "0.18.0",
    "@solana/kit-plugin-signer": "0.18.0",
    "esbuild": "^0.25.6",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "^3.2.4"
  }
}
