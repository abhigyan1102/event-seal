# Server-only web adapter configuration.
# The browser calls /api/verify and never receives these values directly.
INSFORGE_BASE_URL=https://your-project.region.insforge.app
INSFORGE_ANON_KEY=replace-with-your-anon-key

# Server-only InsForge function configuration.
# Never expose INSFORGE_API_KEY in browser code, NEXT_PUBLIC_* variables, screenshots, or public docs.
INSFORGE_API_KEY=replace-with-your-server-api-key

# Server-only Solana verification configuration.
SOLANA_RPC_URL=https://api.devnet.solana.com
EVENTSEAL_CLUSTER=devnet
EVENTSEAL_EXPECTED_PROGRAM_ID=replace-with-program-id
EVENTSEAL_EVENT_FORMAT=anchor-log
EVENTSEAL_EVENT_DISCRIMINATOR=replace-with-16-character-hex

# Server-only Helius webhook authentication.
# Use a random secret and configure the same value in the Helius webhook header.
EVENTSEAL_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
